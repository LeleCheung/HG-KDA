{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["condition", "decisions"],
  "properties": {
    "condition": {"type": "string"},
    "decisions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "action_id", "confidence", "reason"],
        "properties": {
          "case_id": {"type": "string", "enum": ["loop-heldout", "tile-boundary"]},
          "action_id": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string", "maxLength": 400}
        }
      }
    }
  }
}

